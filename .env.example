# API de consumidores: IP de saída precisa estar na whitelist.
JP_BASE_URL=https://jp-token-manager-api.jaupesca.com.br
# Permissões: integrations:read, tokens:read, tokens:refresh.
JP_API_KEY=SUA_CHAVE_DE_AUTENTICACAO

# Banco de destino dos pedidos (continua necessário).
DB_MAGALU_URL=postgresql://user:password@localhost:5432/magalu_db
DB_MAGALU_SCHEMA=magazine_luiza

# Padrão: pedidos atualizados nos últimos 7 x 24h, incluindo todos os status.
SYNC_MODE=recent
SYNC_LOOKBACK_DAYS=7
# Para recuperação histórica, use SYNC_MODE=full em uma execução.
